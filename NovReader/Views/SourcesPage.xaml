<Page
    x:Class="NovReader.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Pivot x:Name="MainPivot" SelectionChanged="MainPivot_SelectionChanged">
            <!-- ==================== 我的书源 ==================== -->
            <PivotItem Header="我的书源" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="FilterBox" Margin="12,0,12,8" PlaceholderText="按名称、分组或域名过滤"
                             AutomationProperties.Name="过滤书源" TextChanged="Filter_Changed"/>

                    <ListView x:Name="SourceView" Grid.Row="1"
                              ItemContainerStyle="{StaticResource PlainListViewItemStyle}"
                              SelectionMode="Single" SelectionChanged="SourceView_SelectionChanged"
                              IsItemClickEnabled="True" ItemClick="SourceView_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ItemTitleTextStyle}"/>
                                        <TextBlock Text="{Binding DisplayDetail}" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="SourceStatusText" Grid.Row="2" Margin="12,6,12,6"
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
                </Grid>
            </PivotItem>

            <!-- ==================== 书源广场 ==================== -->
            <PivotItem Header="书源广场" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="12,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PlazaUrlBox" PlaceholderText="粘贴书源合集 JSON 地址"
                                 AutomationProperties.Name="书源合集地址" InputScope="Url"/>
                        <Button Grid.Column="1" Content="导入" Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="64" Margin="8,0,0,0" AutomationProperties.Name="从链接导入"
                                Click="ImportFromUrl_Click"/>
                    </Grid>

                    <ListView x:Name="PlazaView" Grid.Row="1"
                              IsItemClickEnabled="True" ItemClick="PlazaView_ItemClick"
                              ItemContainerStyle="{StaticResource PlainListViewItemStyle}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ItemTitleTextStyle}"/>
                                    <TextBlock Text="{Binding DisplayDetail}" Style="{StaticResource CaptionTextStyle}"/>
                                    <TextBlock Text="{Binding Url}" Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="2" Margin="12,6,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="PlazaBusyRing" IsActive="False" Width="16" Height="16"
                                      Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="PlazaStatusText" Grid.Column="1"
                                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Text="点「获取列表」从 yuedu.miaogongzi.net 发现书源合集（失败时回落到内置合集地址）。"/>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- ==================== 应用栏：我的书源 ==================== -->
        <CommandBar x:Name="MineBar" Grid.Row="1">
            <AppBarButton Icon="OpenFile" Label="导入 JSON" Click="Import_Click"/>
            <AppBarButton Icon="Save" Label="导出 JSON" Click="Export_Click"/>
            <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="删除选中" Click="Delete_Click"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="添加示例书源" Click="AddSample_Click"/>
                <AppBarButton Label="重新载入" Click="Reload_Click"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- ==================== 应用栏：书源广场 ==================== -->
        <CommandBar x:Name="PlazaBar" Grid.Row="1" Visibility="Collapsed">
            <AppBarButton Icon="Refresh" Label="获取列表" Click="LoadPlaza_Click"/>
            <AppBarButton x:Name="ImportAllButton" Icon="Download" Label="全部导入" Click="ImportAll_Click"/>
            <AppBarButton Icon="Add" Label="手动添加" Click="Manual_Click"/>
        </CommandBar>
    </Grid>
</Page>
