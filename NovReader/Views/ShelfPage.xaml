<Page
    x:Class="NovReader.Views.ShelfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 空状态 ==================== -->
        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" Margin="24,0"
                    Visibility="Collapsed" MaxWidth="420">
            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                       Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="书架还是空的" Style="{StaticResource SubheaderTextStyle}" Margin="0,16,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock Margin="0,8,0,0" TextAlignment="Center" Style="{StaticResource BodyTextStyle}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="先去「搜索」找一本书；还没有书源的话，先到「书源」导入在线书源。"/>
            <Button Content="去搜索" Style="{StaticResource PrimaryButtonStyle}" Margin="0,24,0,0"
                    HorizontalAlignment="Stretch" Click="GoSearch_Click"/>
            <Button Content="导入书源" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0"
                    HorizontalAlignment="Stretch" Click="GoSources_Click"/>
        </StackPanel>

        <!-- ==================== 书架列表 ==================== -->
        <Grid x:Name="ShelfPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ShelfSummaryText" Margin="12,8,12,4" Style="{StaticResource CaptionTextStyle}"/>

            <ListView x:Name="ShelfView" Grid.Row="1"
                      IsItemClickEnabled="True" ItemClick="ShelfView_ItemClick"
                      ItemContainerStyle="{StaticResource PlainListViewItemStyle}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent" Holding="Item_Holding" RightTapped="Item_RightTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 封面：没有网络封面时用书名首字做占位 -->
                            <Grid Grid.Column="0" Width="54" Height="72" VerticalAlignment="Top"
                                  Background="{StaticResource AccentBrush}">
                                <TextBlock Text="{Binding CoverPlaceholder}" FontSize="22" FontWeight="SemiLight"
                                           Foreground="{StaticResource TextOnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding DisplayCover}" Stretch="UniformToFill"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitleTextStyle}"/>
                                <TextBlock Text="{Binding DisplayAuthor}" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Text="{Binding ProgressText}" Margin="0,2,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                                <ProgressBar Value="{Binding ProgressRatio}" Maximum="1" Height="3" MinHeight="3"
                                             Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}"
                                             Background="{StaticResource DividerBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                    Content="&#xE712;" AutomationProperties.Name="更多操作"
                                    ToolTipService.ToolTip="更多" Click="More_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ==================== 应用栏 ==================== -->
        <CommandBar Grid.Row="1">
            <AppBarButton x:Name="ContinueButton" Icon="Play" Label="继续阅读" Click="ContinueReading_Click"/>
            <AppBarButton Icon="Find" Label="搜索" Click="GoSearch_Click"/>
            <AppBarButton x:Name="SortButton" Icon="Sort" Label="排序" Click="Sort_Click"/>
        </CommandBar>
    </Grid>
</Page>
