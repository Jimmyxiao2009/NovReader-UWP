<Page
    x:Class="NovReader.Views.BookDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部细进度条：加载详情 / 目录 / 下载导出时显示 -->
        <ProgressBar x:Name="LoadProgress" Grid.Row="0" Height="4" IsIndeterminate="True"
                     Minimum="0" Maximum="100" Background="Transparent"
                     Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"/>

        <Pivot x:Name="DetailPivot" Grid.Row="1">
            <Pivot.Title>
                <TextBlock x:Name="HeaderText" Text="书籍详情" Style="{StaticResource PivotTitleTextStyle}"/>
            </Pivot.Title>

            <!-- ==================== 详情 ==================== -->
            <PivotItem Header="详情" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,4,12,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="96" Height="128" VerticalAlignment="Top"
                                  Background="{StaticResource AccentBrush}">
                                <TextBlock x:Name="CoverPlaceholder" FontSize="40" FontWeight="SemiLight"
                                           Foreground="{StaticResource TextOnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock x:Name="NameText" Style="{StaticResource SubheaderTextStyle}"
                                           TextWrapping="Wrap" MaxLines="3"/>
                                <TextBlock x:Name="AuthorText" Margin="0,4,0,0"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="MetaText" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextStyle}" MaxLines="3"/>
                                <TextBlock x:Name="SourceText" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TransferStatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextStyle}"/>

                        <TextBlock Text="简介" Style="{StaticResource SectionTextStyle}"/>
                        <TextBlock x:Name="IntroText" Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- ==================== 目录 ==================== -->
            <PivotItem Header="目录" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="12,0,4,4">
                        <TextBlock x:Name="TocStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,0,72,0" Style="{StaticResource CaptionTextStyle}"/>
                        <Button x:Name="ReverseTocButton" HorizontalAlignment="Right" Content="倒序"
                                Style="{StaticResource LinkButtonStyle}" IsEnabled="False"
                                AutomationProperties.Name="目录倒序" Click="ReverseToc_Click"/>
                    </Grid>

                    <ListView x:Name="ChapterView" Grid.Row="1" IsItemClickEnabled="True" ItemClick="Chapter_Click"
                              ItemContainerStyle="{StaticResource PlainListViewItemStyle}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource BodyTextStyle}" TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- ==================== 应用栏 ==================== -->
        <CommandBar Grid.Row="2">
            <!-- 用 Symbol 枚举里的图标：W10M 15254 的 Segoe MDL2 Assets 没有 E736 这类后加的字形，会显示成方框 -->
            <AppBarButton x:Name="ReadButton" Icon="Play" Label="开始阅读" Click="Read_Click"/>
            <AppBarButton x:Name="ShelfButton" Icon="Add" Label="加入书架" Click="Shelf_Click"/>
            <AppBarButton x:Name="SwitchSourceButton" Icon="Switch" Label="换源" Click="SwitchSource_Click"/>
            <AppBarButton x:Name="DownloadButton" Icon="Download" Label="下载全本" IsEnabled="False"
                          Click="Download_Click"/>

            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="ExportButton" Label="导出…" IsEnabled="False" Click="Export_Click"/>
                <AppBarButton x:Name="RefreshButton" Label="重新获取详情和目录" Click="Refresh_Click"/>
                <AppBarButton x:Name="CancelTransferButton" Label="取消下载 / 导出" IsEnabled="False"
                              Click="CancelTransfer_Click"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Grid>
</Page>
