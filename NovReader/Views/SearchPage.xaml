<Page
    x:Class="NovReader.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 搜索框 ==================== -->
        <AutoSuggestBox x:Name="KeywordBox" Grid.Row="0" Margin="12,12,12,0"
                        PlaceholderText="书名或作者" QueryIcon="Find"
                        AutomationProperties.Name="搜索关键字"
                        TextChanged="KeywordBox_TextChanged"
                        SuggestionChosen="KeywordBox_SuggestionChosen"
                        QuerySubmitted="KeywordBox_QuerySubmitted"/>

        <!-- ==================== 范围 ==================== -->
        <Grid Grid.Row="1" Margin="12,8,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ComboBox x:Name="ScopeBox" Grid.Column="0" HorizontalAlignment="Stretch" SelectedIndex="0"
                      AutomationProperties.Name="搜索范围" SelectionChanged="Scope_Changed">
                <ComboBoxItem Content="全部可用书源"/>
                <ComboBoxItem Content="指定书源"/>
            </ComboBox>

            <CheckBox x:Name="PreciseCheck" Grid.Column="1" Content="精准" Margin="12,0,0,0" MinWidth="0"
                      AutomationProperties.Name="精准搜索"
                      ToolTipService.ToolTip="只保留书名或作者包含关键字的结果"
                      Checked="Precise_Changed" Unchecked="Precise_Changed"/>

            <ComboBox x:Name="SourceBox" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                      Margin="0,8,0,0" DisplayMemberPath="DisplayName" Visibility="Collapsed"
                      AutomationProperties.Name="书源"
                      SelectionChanged="SourceBox_SelectionChanged"/>
        </Grid>

        <!-- ==================== 状态 ==================== -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <ProgressBar x:Name="SearchProgress" Height="4" Minimum="0" Maximum="1" Value="0"
                         Foreground="{StaticResource AccentBrush}" Background="Transparent"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Margin="12,4,12,4" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextStyle}" Text="输入关键字开始搜索"/>
        </StackPanel>

        <!-- ==================== 结果 / 历史 ==================== -->
        <Grid Grid.Row="3">
            <ListView x:Name="ResultsView" IsItemClickEnabled="True" SelectionMode="None"
                      ItemClick="ResultsView_ItemClick"
                      ItemContainerStyle="{StaticResource PlainListViewItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="48" Height="64" VerticalAlignment="Top"
                                  Background="{StaticResource AccentBrush}">
                                <TextBlock Text="{Binding CoverPlaceholder}" FontSize="20"
                                           Foreground="{StaticResource TextOnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitleTextStyle}"/>
                                <TextBlock Text="{Binding AuthorLine}" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Text="{Binding LatestLine}" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource TextTertiaryBrush}"/>
                                <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                    Content="{Binding ShelfGlyph}" AutomationProperties.Name="{Binding ShelfLabel}"
                                    ToolTipService.ToolTip="{Binding ShelfLabel}" Click="AddShelf_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid x:Name="HistoryPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="12,8,4,0">
                    <TextBlock Text="最近搜索" Style="{StaticResource SectionTextStyle}" Margin="0"
                               VerticalAlignment="Center"/>
                    <Button Content="清除" HorizontalAlignment="Right" Style="{StaticResource LinkButtonStyle}"
                            AutomationProperties.Name="清除搜索历史" Click="ClearHistory_Click"/>
                </Grid>
                <ListView x:Name="HistoryList" Grid.Row="1" IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="HistoryList_ItemClick"
                          ItemContainerStyle="{StaticResource PlainListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextStyle}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- ==================== 应用栏 ==================== -->
        <CommandBar x:Name="SearchBar" Grid.Row="4" ClosedDisplayMode="Compact">
            <AppBarButton x:Name="StopButton" Icon="Stop" Label="停止" IsEnabled="False"
                          Click="Cancel_Click"/>
            <AppBarButton x:Name="SortButton" Icon="Sort" Label="排序" IsEnabled="False">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="SortRelevance" Text="相关度" Tag="0" Click="Sort_Click"/>
                        <MenuFlyoutItem x:Name="SortArrival" Text="到达顺序" Tag="1" Click="Sort_Click"/>
                        <MenuFlyoutItem x:Name="SortName" Text="书名" Tag="2" Click="Sort_Click"/>
                        <MenuFlyoutItem x:Name="SortSources" Text="书源数量" Tag="3" Click="Sort_Click"/>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="ClearButton" Icon="Clear" Label="清空" Click="Clear_Click"/>
        </CommandBar>
    </Grid>
</Page>
