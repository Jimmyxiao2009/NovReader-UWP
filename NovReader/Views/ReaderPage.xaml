<Page
    x:Class="NovReader.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶部栏 ==================== -->
        <Border x:Name="TopBar" Grid.Row="0" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Content="&#xE72B;"
                        AutomationProperties.Name="返回" Margin="6,0,0,0"
                        ToolTipService.ToolTip="返回" Click="Back_Click"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                    <TextBlock x:Name="BookTitleText" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ChapterTitleText" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8FD;"
                            AutomationProperties.Name="目录"
                            ToolTipService.ToolTip="目录" Click="ToggleToc_Click"/>
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE713;"
                            AutomationProperties.Name="阅读设置"
                            ToolTipService.ToolTip="阅读设置" Click="ToggleSettings_Click"/>
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE712;"
                            AutomationProperties.Name="更多阅读功能" ToolTipService.ToolTip="更多">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="添加书签" Click="AddBookmark_Click"/>
                                <MenuFlyoutItem Text="书签与笔记" Click="ShowBookmarks_Click"/>
                                <MenuFlyoutItem Text="查找本章文字" Click="ShowFind_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="放大当前图片" Click="ZoomCurrentImage_Click"/>
                                <MenuFlyoutItem Text="重试失败图片" Click="RetryFailedImages_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 正文 ==================== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="ReaderScroll" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Enabled"
                          ZoomMode="Disabled"
                          Tapped="ReaderScroll_Tapped"
                          ViewChanged="ReaderScroll_ViewChanged"
                          SizeChanged="ReaderScroll_SizeChanged">
                <Grid x:Name="ContentHost" Padding="0,10,0,40">
                    <TextBlock x:Name="ContentBlock"
                               TextWrapping="Wrap"
                               LineStackingStrategy="BlockLineHeight"
                               IsTextSelectionEnabled="False"
                               HorizontalAlignment="Stretch"/>

                    <!-- 漫画 / 插图：图片与文字按顺序竖排 -->
                    <StackPanel x:Name="ImageHost" Visibility="Collapsed"/>

                    <!-- 有声书源：正文是音频地址 -->
                    <StackPanel x:Name="AudioPanel" Visibility="Collapsed" Margin="0,24,0,0">
                        <TextBlock x:Name="AudioTitleText" TextWrapping="Wrap" FontSize="20" Margin="0,0,0,16"/>
                        <MediaElement x:Name="AudioPlayer" AutoPlay="False" AreTransportControlsEnabled="True"
                                      Height="120" MediaFailed="AudioPlayer_MediaFailed"/>
                        <TextBlock x:Name="AudioStatusText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                   Text="点播放键开始收听。离开阅读页后会停止播放。"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 加载中 -->
            <StackPanel x:Name="LoadingPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="34" Height="34"
                              Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="LoadingText" Text="正在加载正文…" Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- 出错 / 空内容 -->
            <StackPanel x:Name="ErrorPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" MaxWidth="420">
                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextTertiaryBrush}"/>
                <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="重试" Style="{StaticResource SecondaryButtonStyle}" Click="Retry_Click"/>
                    <Button Content="换源 / 详情" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                            Click="OpenDetail_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- 页码浮层（翻页模式） -->
            <Border x:Name="PageIndicator" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,12,10" Padding="8,2"
                    Background="{StaticResource AccentSoftBrush}" Visibility="Collapsed">
                <TextBlock x:Name="PageIndicatorText" FontSize="12"
                           Foreground="{StaticResource AccentBrush}"/>
            </Border>

            <Border x:Name="FindPanel" VerticalAlignment="Top" Margin="8" Padding="10"
                    Background="{StaticResource AppBackgroundBrush}" BorderThickness="1"
                    BorderBrush="{StaticResource DividerBrush}" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FindBox" PlaceholderText="查找本章文字" MaxLength="100" KeyDown="FindBox_KeyDown"/>
                        <Button Grid.Column="1" Content="查找" Margin="6,0,0,0" Click="FindText_Click"/>
                    </Grid>
                    <TextBlock x:Name="FindStatusText" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="上一处" Click="FindPrevious_Click"/>
                        <Button Content="下一处" Margin="6,0,0,0" Click="FindNext_Click"/>
                        <Button Content="关闭" Margin="6,0,0,0" Click="CloseFind_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 底部栏 ==================== -->
        <Border x:Name="BottomBar" Grid.Row="2" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid Height="52" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Content="&#xE892;"
                        AutomationProperties.Name="上一章" ToolTipService.ToolTip="上一章" Click="PrevChapter_Click"/>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE893;"
                        AutomationProperties.Name="下一章" ToolTipService.ToolTip="下一章" Click="NextChapter_Click"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                    <Slider x:Name="ChapterSlider" Minimum="0" Maximum="0" StepFrequency="1"
                            ValueChanged="ChapterSlider_ValueChanged"
                            Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="ProgressText" FontSize="11" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Content="&#xE7C3;"
                        AutomationProperties.Name="切换翻页方式"
                        ToolTipService.ToolTip="切换翻页方式" Click="TogglePageMode_Click"/>
                <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Content="&#xE8A7;"
                        AutomationProperties.Name="沉浸阅读"
                        ToolTipService.ToolTip="沉浸阅读" Click="ToggleBars_Click"/>
            </Grid>
        </Border>

        <!-- ==================== 目录抽屉 ==================== -->
        <Grid x:Name="TocLayer" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Rectangle Fill="#66000000" Tapped="TocBackdrop_Tapped"/>
            <Border HorizontalAlignment="Right" Width="320" Background="{StaticResource ChromeBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Height="48" Margin="12,0,12,0">
                        <TextBlock Text="目录" VerticalAlignment="Center" Style="{StaticResource PivotTitleTextStyle}"/>
                        <TextBlock x:Name="TocCountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}"/>
                    </Grid>

                    <ListView x:Name="TocList" Grid.Row="1" IsItemClickEnabled="True"
                              ItemClick="TocList_ItemClick"
                              ItemContainerStyle="{StaticResource PlainListViewItemStyle}"
                              SelectionMode="Single"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 设置面板 ==================== -->
        <Grid x:Name="SettingsLayer" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Rectangle Fill="#66000000" Tapped="SettingsBackdrop_Tapped"/>
            <Border x:Name="SettingsPanel" VerticalAlignment="Bottom" Padding="16,14,16,18"
                    BorderThickness="0,1,0,0" BorderBrush="{StaticResource DividerBrush}">
                <ScrollViewer MaxHeight="420">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="阅读设置" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}"
                                    Content="&#xE711;" AutomationProperties.Name="关闭设置"
                                    Click="CloseSettings_Click"/>
                        </Grid>

                        <!-- 字号 -->
                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="字号" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="FontSizeText" HorizontalAlignment="Right" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                        <Slider x:Name="FontSizeSlider" Minimum="14" Maximum="40" StepFrequency="1"
                                Margin="0,4,0,0" ValueChanged="FontSizeSlider_ValueChanged"/>

                        <!-- 行距 -->
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="行距" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="LineHeightText" HorizontalAlignment="Right" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                        <Slider x:Name="LineHeightSlider" Minimum="1.2" Maximum="2.6" StepFrequency="0.1"
                                Margin="0,4,0,0" ValueChanged="LineHeightSlider_ValueChanged"/>

                        <!-- 页边距 -->
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="页边距" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="PaddingText" HorizontalAlignment="Right" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                        <Slider x:Name="PaddingSlider" Minimum="8" Maximum="48" StepFrequency="2"
                                Margin="0,4,0,0" ValueChanged="PaddingSlider_ValueChanged"/>

                        <!-- 主题 -->
                        <TextBlock Text="主题" FontSize="13" Margin="0,14,0,6"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ThemeDay" Style="{StaticResource ThemeSwatchStyle}" Tag="Day"
                                    Click="Theme_Click">
                                <TextBlock Text="日间" FontSize="12" Foreground="#FF1A1A1A"/>
                            </Button>
                            <Button x:Name="ThemeSepia" Style="{StaticResource ThemeSwatchStyle}" Tag="Sepia"
                                    Background="#FFF6ECD8" Click="Theme_Click">
                                <TextBlock Text="羊皮" FontSize="12" Foreground="#FF4A3C2A"/>
                            </Button>
                            <Button x:Name="ThemeGreen" Style="{StaticResource ThemeSwatchStyle}" Tag="Green"
                                    Background="#FFCCE8CF" Click="Theme_Click">
                                <TextBlock Text="护眼" FontSize="12" Foreground="#FF203026"/>
                            </Button>
                            <Button x:Name="ThemeNight" Style="{StaticResource ThemeSwatchStyle}" Tag="Night"
                                    Background="#FF121212" Click="Theme_Click">
                                <TextBlock Text="夜间" FontSize="12" Foreground="#FF9E9E9E"/>
                            </Button>
                            <Button x:Name="ThemeBlack" Style="{StaticResource ThemeSwatchStyle}" Tag="Black"
                                    Background="#FF000000" Click="Theme_Click">
                                <TextBlock Text="纯黑" FontSize="12" Foreground="#FF8A8A8A"/>
                            </Button>
                        </StackPanel>

                        <!-- 字体 -->
                        <TextBlock Text="字体" FontSize="13" Margin="0,14,0,6"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="FontCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="FontCombo_SelectionChanged"/>

                        <!-- 翻页方式 -->
                        <TextBlock Text="翻页方式" FontSize="13" Margin="0,14,0,6"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PageTurnPage" Content="翻页" GroupName="PageTurn"
                                         Checked="PageTurn_Changed"/>
                            <RadioButton x:Name="PageTurnScroll" Content="滚动" GroupName="PageTurn"
                                         Margin="16,0,0,0" Checked="PageTurn_Changed"/>
                        </StackPanel>

                        <!-- 排版开关 -->
                        <!-- 手机竖屏宽度只有 360 左右，三个选项横排会被裁掉，改成两列 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="IndentCheck" Content="首行缩进" Checked="Layout_Changed"
                                      Unchecked="Layout_Changed"/>
                            <CheckBox x:Name="BlankLineCheck" Grid.Column="1" Content="段间空行"
                                      Checked="Layout_Changed" Unchecked="Layout_Changed"/>
                            <CheckBox x:Name="KeepAwakeCheck" Grid.Row="1" Content="屏幕常亮"
                                      Checked="KeepAwake_Changed" Unchecked="KeepAwake_Changed"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="BookmarkLayer" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Rectangle Fill="#66000000" Tapped="BookmarkBackdrop_Tapped"/>
            <Border HorizontalAlignment="Right" Width="320" Background="{StaticResource AppBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="12,8">
                        <TextBlock Text="书签与笔记" FontSize="18" VerticalAlignment="Center"/>
                        <Button Content="关闭" HorizontalAlignment="Right" Click="CloseBookmarks_Click"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="BookmarkEmptyText" Text="还没有书签。在更多菜单中添加当前位置。"
                                   Margin="16" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <ListView x:Name="BookmarkList" IsItemClickEnabled="True" ItemClick="BookmarkList_ItemClick" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6">
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="15"/>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="备注" Click="EditBookmark_Click"/>
                                            <Button Content="删除" Margin="8,0,0,0" Click="DeleteBookmark_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Button Grid.Row="2" Content="添加当前位置" Margin="12" Click="AddBookmark_Click"/>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ImageZoomLayer" Grid.Row="0" Grid.RowSpan="3" Background="#FF111111" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Height="48">
                <TextBlock Text="双指缩放 · 双击复位" Foreground="White" Margin="12,0,72,0" FontSize="13" VerticalAlignment="Center"/>
                <Button Content="关闭" HorizontalAlignment="Right" Margin="6" Click="CloseZoom_Click"/>
            </Grid>
            <ScrollViewer x:Name="ImageZoomScroll" Grid.Row="1" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="5"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" DoubleTapped="ImageZoomScroll_DoubleTapped">
                <Image x:Name="ImageZoomContent" Stretch="Uniform" VerticalAlignment="Top"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
